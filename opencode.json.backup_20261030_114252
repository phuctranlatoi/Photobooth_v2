{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "9router/kr/claude-sonnet-4.5-thinking-agentic",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "E:/HK1_2026_2027/PhotoboothDesktop/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "E:/HK1_2026_2027/PhotoboothDesktop/.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "E:/HK1_2026_2027/PhotoboothDesktop/build/Cloudinary_Archive_*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "E:/HK1_2026_2027/PhotoboothDesktop/build/Cloudinary_Archive_*/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "E:/HK1_2026_2027/PhotoboothDesktop",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "E:/HK1_2026_2027/PhotoboothDesktop/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "9router/kr/claude-sonnet-4.5-thinking-agentic",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "legacy-auditor",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "architect",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "ui-designer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "frontend-coder",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "camera-engineer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "printer-engineer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "backend-engineer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "tester-reviewer",
          "effect": "allow"
        }
      ]
    },
    "legacy-auditor": {
      "mode": "subagent",
      "model": "9router/ollama/gpt-oss:120b"
    },
    "architect": {
      "mode": "subagent",
      "model": "9router/ollama/nemotron-3-ultra"
    },
    "ui-designer": {
      "mode": "subagent",
      "model": "9router/cx/gpt-6.1-sol"
    },
    "frontend-coder": {
      "mode": "subagent",
      "model": "9router/cx/gpt-6.1-sol"
    },
    "camera-engineer": {
      "mode": "subagent",
      "model": "9router/cx/gpt-6.1-terra"
    },
    "printer-engineer": {
      "mode": "subagent",
      "model": "9router/cx/gpt-6.1-terra"
    },
    "backend-engineer": {
      "mode": "subagent",
      "model": "9router/cx/gpt-6.1-sol"
    },
    "tester-reviewer": {
      "mode": "subagent",
      "model": "9router/cx/gpt-5.6-sol-review"
    }
  }
}
