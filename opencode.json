  "default_agent": "orchestrator",
  "model": "9router/cx/gpt-6.1-sol",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "E:/HK1_2026_2027/PhotoboothDesktop/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*serviceAccountKey.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*service-account*.json",
      "effect": "deny"
    },
    {
      "action": "read",
