    {
      "action": "read",
      "resource": "E:/HK1_2026_2027/PhotoboothDesktop/build/Cloudinary_Archive_*/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset *",
      "effect": "deny"
    },
    {
